[Unit]
Description=LiteLLM Multi-Tier Proxy & Spend Gateway
After=network.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/loop/litellm.env
ExecStart=%h/.local/bin/litellm --config %h/.config/loop/litellm/config.yaml --port 4000 --host 127.0.0.1
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
