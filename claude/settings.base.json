{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git push *)",
      "Bash(gh pr create --draft *)",
      "Bash(gh repo fork *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)"
    ],
    "ask": [
      "Bash(gh pr ready *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push *+*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(gh repo delete *)",
      "Bash(gh release *)",
      "Bash(gh auth *)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gh-academic/**)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push *",
      "gh *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gh",
        "~/.config/gh-academic",
        "~/**/.env",
        "~/**/.env.*"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Work/agent-stack/claude/hooks/pre-push-checks.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
