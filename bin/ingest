#!/usr/bin/env bash
set -eo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
DEFAULT_OUT_DIR="${REPO_ROOT}/.context/sources"
OUT_DIR=""
INPUT_PATH=""

# ANSI formatting
BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
RESET="\033[0m"

log_info() { echo -e "${BLUE}[INFO]${RESET} $1"; }
log_ok()   { echo -e "${GREEN}[OK]${RESET} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${RESET} $1"; }
log_err()  { echo -e "${RED}[ERROR]${RESET} $1"; exit 1; }

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output|-o)
      OUT_DIR="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: ingest [OPTIONS] <file-or-directory>"
      echo ""
      echo "Converts documents, notebooks, data, and audio into structured Markdown."
      echo ""
      echo "Options:"
      echo "  -o, --output <dir>   Output directory (default: .context/sources/)"
      echo "  -h, --help           Show this help message"
      exit 0
      ;;
    *)
      if [ -z "$INPUT_PATH" ]; then
        INPUT_PATH="$1"
      else
        INPUT_PATH="$INPUT_PATH $1"
      fi
      shift
      ;;
  esac
done

[ -z "$INPUT_PATH" ] && log_err "No input file or directory specified."
[ ! -e "$INPUT_PATH" ] && log_err "Path not found: $INPUT_PATH"

OUT_DIR="${OUT_DIR:-$DEFAULT_OUT_DIR}"
mkdir -p "$OUT_DIR"

ingest_file() {
  local src="$1"
  local filename
  filename="$(basename "$src")"
  local stem="${filename%.*}"
  local ext="${filename##*.}"
  ext="$(echo "$ext" | tr '[:upper:]' '[:lower:]')"
  local dest="${OUT_DIR}/${stem}.md"

  log_info "Ingesting: ${BOLD}$filename${RESET} -> $(basename "$dest")"

  case "$ext" in
    pdf)
      if command -v docling >/dev/null 2>&1; then
        docling "$src" --to md --output "$OUT_DIR" >/dev/null 2>&1 || {
          log_warn "Docling conversion failed for $filename; falling back to pandoc."
          pandoc "$src" -t markdown -o "$dest" 2>/dev/null || pdftotext "$src" "$dest"
        }
      elif command -v pandoc >/dev/null 2>&1; then
        pandoc "$src" -t markdown -o "$dest" 2>/dev/null || pdftotext "$src" "$dest"
      elif command -v pdftotext >/dev/null 2>&1; then
        pdftotext "$src" "$dest"
      else
        log_err "Neither docling, pandoc, nor pdftotext found for PDF processing."
      fi
      ;;

    docx|odt|epub|html|htm)
      if command -v pandoc >/dev/null 2>&1; then
        pandoc "$src" -t markdown --wrap=none -o "$dest"
      else
        log_err "Pandoc is required to convert $ext documents."
      fi
      ;;

    ipynb)
      if command -v jupytext >/dev/null 2>&1; then
        jupytext --to markdown "$src" -o "$dest"
      else
        log_err "Jupytext is required to convert Jupyter Notebooks."
      fi
      ;;

    parquet)
      if command -v duckdb >/dev/null 2>&1; then
        {
          echo "# Dataset Schema & Sample: ${filename}"
          echo ""
          echo "## Schema"
          echo '```sql'
          duckdb -box -c "DESCRIBE SELECT * FROM '${src}';"
          echo '```'
          echo ""
          echo "## Sample Records (Top 5)"
          echo '```text'
          duckdb -box -c "SELECT * FROM '${src}' LIMIT 5;"
          echo '```'
        } > "$dest"
      else
        log_err "DuckDB CLI is required to inspect Parquet tables."
      fi
      ;;

    csv|tsv)
      if command -v duckdb >/dev/null 2>&1; then
        {
          echo "# Dataset Digest: ${filename}"
          echo ""
          echo "## Schema"
          echo '```sql'
          duckdb -box -c "DESCRIBE SELECT * FROM read_csv_auto('${src}');"
          echo '```'
          echo ""
          echo "## Sample Records (Top 10)"
          echo '```text'
          duckdb -box -c "SELECT * FROM read_csv_auto('${src}') LIMIT 10;"
          echo '```'
        } > "$dest"
      else
        log_warn "DuckDB not found; copying raw text sample."
        head -n 25 "$src" > "$dest"
      fi
      ;;

    mp3|wav|m4a|ogg|flac)
      if command -v whisper-cpp >/dev/null 2>&1; then
        whisper-cpp -f "$src" -otxt -of "${OUT_DIR}/${stem}" >/dev/null
        mv "${OUT_DIR}/${stem}.txt" "$dest"
      elif command -v whisper >/dev/null 2>&1; then
        whisper "$src" --output_format txt --output_dir "$OUT_DIR" >/dev/null
        mv "${OUT_DIR}/${stem}.txt" "$dest"
      else
        log_warn "Whisper not found; skipping audio transcription for $filename."
        return 0
      fi
      ;;

    md|txt|json|yaml|yml|toml)
      cp "$src" "$dest"
      ;;

    *)
      log_warn "Unsupported file extension '.$ext' for $filename. Skipping."
      return 0
      ;;
  esac

  log_ok "Generated: $dest"
}

# Process single file or traverse directory
if [ -f "$INPUT_PATH" ]; then
  ingest_file "$INPUT_PATH"
elif [ -d "$INPUT_PATH" ]; then
  find "$INPUT_PATH" -type f -not -path '*/.*' | while read -r item; do
    ingest_file "$item"
  done
fi

log_ok "Ingestion complete. Sources available in: $OUT_DIR"
