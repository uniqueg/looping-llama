#!/usr/bin/env python3
import argparse
import datetime
import json
import os
import platform
import subprocess
import sys
import uuid


def run_cmd(cmd: list[str]) -> str:
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return ""


def main():
    parser = argparse.ArgumentParser(
        description="Attach W3C PROV / RO-Crate JSON-LD metadata to Git Notes."
    )
    parser.add_argument("--commit", default="HEAD", help="Target commit SHA")
    parser.add_argument("--task", required=True, help="Task description or goal")
    parser.add_argument("--role", default="swe", help="Active role")
    parser.add_argument("--scope", default="personal", help="Active scope")
    parser.add_argument("--env", default="local", help="Active environment")
    parser.add_argument(
        "--ref", default="refs/notes/provenance", help="Git Notes reference ref"
    )
    parser.add_argument(
        "--output", help="Optional path to write raw JSON-LD file to disk"
    )

    args = parser.parse_args()

    commit_sha = run_cmd(["git", "rev-parse", args.commit])
    if not commit_sha:
        print(f"[ERROR] Could not resolve commit '{args.commit}'", file=sys.stderr)
        sys.exit(1)

    repo_url = run_cmd(["git", "config", "--get", "remote.origin.url"])
    author_name = run_cmd(["git", "log", "-1", "--format=%an", commit_sha])
    author_email = run_cmd(["git", "log", "-1", "--format=%ae", commit_sha])
    commit_date = run_cmd(["git", "log", "-1", "--format=%aI", commit_sha])

    now_iso = datetime.datetime.now(datetime.timezone.utc).isoformat()
    run_id = str(uuid.uuid4())

    crate = {
        "@context": [
            "https://w3id.org/ro/crate/1.1/context",
            {
                "prov": "http://www.w3.org/ns/prov#",
                "xsd": "http://www.w3.org/2001/XMLSchema#",
            },
        ],
        "@graph": [
            {
                "@id": "ro-crate-metadata.json",
                "@type": "CreativeWork",
                "conformsTo": {"@id": "https://w3id.org/ro/crate/1.1"},
                "about": {"@id": "./"},
            },
            {
                "@id": "./",
                "@type": "Dataset",
                "name": f"Provenance Trace for Commit {commit_sha[:8]}",
                "datePublished": now_iso,
                "description": args.task,
            },
            {
                "@id": f"#run-{run_id}",
                "@type": ["CreateAction", "prov:Activity"],
                "name": "Looping Llama Autonomous Run",
                "description": args.task,
                "startTime": commit_date or now_iso,
                "endTime": now_iso,
                "actionStatus": "CompletedActionStatus",
                "agent": {"@id": f"#agent-{args.role}"},
                "instrument": {"@id": "#engine-looping-llama"},
                "object": {"@id": f"urn:git:commit:{commit_sha}"},
                "prov:wasAssociatedWith": [
                    {"@id": f"#agent-{args.role}"},
                    {"@id": f"#user-{author_name}"},
                ],
                "prov:generated": {"@id": f"urn:git:commit:{commit_sha}"},
            },
            {
                "@id": f"#agent-{args.role}",
                "@type": ["SoftwareApplication", "prov:Agent"],
                "name": f"Looping Llama Role @{args.role}",
                "applicationCategory": args.role,
                "runtimePlatform": platform.platform(),
            },
            {
                "@id": f"#user-{author_name}",
                "@type": ["Person", "prov:Agent"],
                "name": author_name or "Unknown Operator",
                "email": author_email or "",
            },
            {
                "@id": "#engine-looping-llama",
                "@type": ["SoftwareApplication", "prov:SoftwareAgent"],
                "name": "Looping Llama",
                "url": "https://github.com/looping-llama",
            },
            {
                "@id": f"urn:git:commit:{commit_sha}",
                "@type": ["DigitalDocument", "prov:Entity"],
                "identifier": commit_sha,
                "isPartOf": repo_url or "local-repository",
                "scope": args.scope,
                "environment": args.env,
            },
        ],
    }

    json_payload = json.dumps(crate, indent=2)

    # Attach to git notes
    cmd = ["git", "notes", f"--ref={args.ref}", "add", "-f", "-m", json_payload, commit_sha]
    res = subprocess.run(cmd, capture_output=True, text=True)

    if res.returncode != 0:
        print(f"[ERROR] Failed to attach git note: {res.stderr}", file=sys.stderr)
        sys.exit(1)

    print(f"[OK] Attached RO-Crate provenance to commit {commit_sha[:8]} under {args.ref}")

    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(json_payload)
        print(f"[OK] Wrote metadata to {args.output}")


if __name__ == "__main__":
    main()
