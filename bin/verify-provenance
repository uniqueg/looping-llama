#!/usr/bin/env bash
# Looping Llama - Cryptographic Provenance Verifier
set -euo pipefail

REF="refs/notes/provenance"
SIG_REF="refs/notes/provenance.sig"
SCOPE=""
COMMIT_SHA=""
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/loop"

log_info()  { echo -e "\033[1;34m[INFO]\033[0m $*"; }
log_ok()    { echo -e "\033[1;32m[OK]\033[0m $*"; }
log_warn()  { echo -e "\033[1;33m[WARN]\033[0m $*"; }
log_error() { echo -e "\033[1;31m[ERROR]\033[0m $*" >&2; }

usage() {
    cat <<USAGE
Usage: $(basename "$0") --commit <commit> --scope <scope> [options]

Verify cryptographic authenticity of git provenance notes using Cosign bundles.

Options:
    -c, --commit <sha>   Target commit SHA or reference (required)
    -s, --scope <name>   Scope name providing public verification key (required)
        --ref <ref>      Source git notes ref (default: refs/notes/provenance)
        --sig-ref <ref>  Source signatures git notes ref (default: refs/notes/provenance.sig)
    -h, --help           Show this message
USAGE
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--commit) COMMIT_SHA="$2"; shift 2 ;;
        -s|--scope) SCOPE="$2"; shift 2 ;;
        --ref) REF="$2"; shift 2 ;;
        --sig-ref) SIG_REF="$2"; shift 2 ;;
        -h|--help) usage ;;
        *) log_error "Unknown argument: $1"; usage ;;
    esac
done

if [[ -z "$COMMIT_SHA" || -z "$SCOPE" ]]; then
    log_error "Both --commit and --scope are mandatory."
    exit 1
fi

COMMIT_SHA="$(git rev-parse --verify "$COMMIT_SHA" 2>/dev/null)" || {
    log_error "Invalid commit target: $COMMIT_SHA"
    exit 1
}

SCOPE_MANIFEST="$CONFIG_ROOT/scopes/${SCOPE}.toml"
if [[ ! -f "$SCOPE_MANIFEST" ]]; then
    log_error "Scope manifest not found: $SCOPE_MANIFEST"
    exit 1
fi

PUB_KEY="$(grep -E '^[[:space:]]*cosign_pub[[:space:]]*=' "$SCOPE_MANIFEST" | head -n1 | cut -d'=' -f2- | tr -d ' "')"
PUB_KEY="${PUB_KEY/#\~/$HOME}"

if [[ -z "$PUB_KEY" || ! -f "$PUB_KEY" ]]; then
    log_error "Cosign public key not found at '$PUB_KEY' defined in scope '$SCOPE'."
    exit 1
fi

PROVENANCE_PAYLOAD="$(git notes --ref="$REF" show "$COMMIT_SHA" 2>/dev/null)" || {
    log_error "No provenance note found on commit ${COMMIT_SHA:0:8} under ref '$REF'."
    exit 1
}

PROVENANCE_SIG="$(git notes --ref="$SIG_REF" show "$COMMIT_SHA" 2>/dev/null)" || {
    echo -e "\033[1;31m[REJECTED]\033[0m No signature found on commit ${COMMIT_SHA:0:8} under ref '$SIG_REF'."
    exit 2
}

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

PAYLOAD_FILE="$TMP_DIR/payload.json"
BUNDLE_FILE="$TMP_DIR/bundle.json"
echo "$PROVENANCE_PAYLOAD" > "$PAYLOAD_FILE"
echo "$PROVENANCE_SIG" > "$BUNDLE_FILE"

log_info "Verifying provenance signature for commit ${COMMIT_SHA:0:8} against key: $PUB_KEY..."

if cosign verify-blob \
    --key "$PUB_KEY" \
    --bundle "$BUNDLE_FILE" \
    --insecure-ignore-tlog \
    "$PAYLOAD_FILE" >/dev/null 2>&1; then
    log_ok "Signature valid. Commit ${COMMIT_SHA:0:8} provenance integrity verified for scope '$SCOPE'."
    exit 0
else
    echo -e "\033[1;31m[REJECTED]\033[0m Cryptographic verification failed! Tampering detected or key mismatch."
    exit 3
fi
