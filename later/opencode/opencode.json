{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "options": { "apiKey": "{env:GEMINI_API_KEY}" }
    }
  },
  "model": "google/gemini-3.1-pro-preview",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "ls*": "allow",
      "rg *": "allow",
      "git push*": "ask",
      "gh *": "ask",
      "gh auth*": "deny",
      "gopass*": "deny",
      "env*": "deny",
      "printenv*": "deny",
      "set": "deny"
    }
  }
}
