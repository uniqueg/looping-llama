#!/usr/bin/env python3
"""Verify the references in a BibTeX file against Crossref, DataCite, PubMed and doi.org.

Usage: verify-citations refs.bib [--text paper.md ...]

Per entry:
  OK    DOI (Crossref/DataCite) or PMID (PubMed) resolves and the title matches
  WARN  DOI resolves only via doi.org (title could not be compared), or the year differs
  FAIL  identifier missing or unresolvable, or title mismatch
With --text, citation keys ([@key]) used in the documents but missing from the
.bib file are reported as FAIL.

Exits 1 if any FAIL. Env: CROSSREF_MAILTO (polite pool), NCBI_API_KEY (optional).
Standard library only.
"""
import argparse
import difflib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

MAILTO = os.environ.get("CROSSREF_MAILTO", "")
NCBI_KEY = os.environ.get("NCBI_API_KEY", "")
UA = f"verify-citations/1.0 (mailto:{MAILTO})" if MAILTO else "verify-citations/1.0"
TITLE_THRESHOLD = 0.85


def get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=20) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            if e.code == 429 and attempt < 2:
                time.sleep(2 ** attempt)
                continue
            raise
    return None


def parse_bib(text):
    """Minimal BibTeX parser: returns {key: {field: value}}. Handles nested braces."""
    entries = {}
    for m in re.finditer(r"@(\w+)\s*\{\s*([^,\s]+)\s*,", text):
        if m.group(1).lower() in ("comment", "string", "preamble"):
            continue
        key, pos, depth = m.group(2), m.end(), 1
        start = pos
        while pos < len(text) and depth:
            depth += {"{": 1, "}": -1}.get(text[pos], 0)
            pos += 1
        body = text[start:pos - 1]
        fields = {}
        for f in re.finditer(r"(\w+)\s*=\s*", body):
            i = f.end()
            if i >= len(body):
                break
            if body[i] == "{":
                d, j = 1, i + 1
                while j < len(body) and d:
                    d += {"{": 1, "}": -1}.get(body[j], 0)
                    j += 1
                val = body[i + 1:j - 1]
            elif body[i] == '"':
                j = body.index('"', i + 1)
                val = body[i + 1:j]
            else:
                val = re.match(r"[^,\s}]+", body[i:]).group(0)
            fields.setdefault(f.group(1).lower(), val)
        entries[key] = fields
    return entries


def norm(s):
    s = re.sub(r"[{}\\$]", "", s or "")
    return re.sub(r"\W+", " ", s).strip().lower()


def similar(a, b):
    return difflib.SequenceMatcher(None, norm(a), norm(b)).ratio()


def check_doi(doi):
    """Return (found_title, year, source) or None if the DOI does not resolve."""
    doi = re.sub(r"^https?://(dx\.)?doi\.org/", "", doi.strip())
    data = get_json("https://api.crossref.org/works/" + urllib.parse.quote(doi))
    if data:
        msg = data["message"]
        title = (msg.get("title") or [""])[0]
        parts = (msg.get("issued") or {}).get("date-parts") or [[None]]
        return title, parts[0][0], "crossref"
    data = get_json("https://api.datacite.org/dois/" + urllib.parse.quote(doi))
    if data:
        attrs = data["data"]["attributes"]
        title = ((attrs.get("titles") or [{}])[0]).get("title", "")
        return title, attrs.get("publicationYear"), "datacite"
    handle = get_json("https://doi.org/api/handles/" + urllib.parse.quote(doi))
    if handle and handle.get("responseCode") == 1:
        return None, None, "doi.org"
    return None


def check_pmid(pmid):
    q = {"db": "pubmed", "id": pmid, "retmode": "json"}
    if NCBI_KEY:
        q["api_key"] = NCBI_KEY
    data = get_json("https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?" + urllib.parse.urlencode(q))
    rec = (data or {}).get("result", {}).get(str(pmid))
    if not rec or "error" in rec:
        return None
    return rec.get("title", ""), (rec.get("pubdate") or "")[:4], "pubmed"


def verify(key, f):
    title, year = f.get("title", ""), (f.get("year") or f.get("date", ""))[:4]
    if f.get("doi"):
        res, ident = check_doi(f["doi"]), "doi:" + f["doi"]
    elif f.get("pmid"):
        res, ident = check_pmid(f["pmid"]), "pmid:" + f["pmid"]
    else:
        return "FAIL", "no DOI or PMID"
    if res is None:
        return "FAIL", f"{ident} does not resolve"
    found_title, found_year, src = res
    if found_title is None:
        return "WARN", f"{ident} resolves via {src}; title not checked"
    score = similar(title, found_title)
    if score < TITLE_THRESHOLD:
        return "FAIL", f"title mismatch ({score:.2f}) via {src}: registry says {found_title!r}"
    if year and found_year and str(found_year) != year:
        return "WARN", f"year {year} vs {found_year} ({src})"
    return "OK", f"{ident} ({src})"


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("bib")
    ap.add_argument("--text", nargs="*", default=[], help="Markdown files whose [@key] citations must exist in the bib")
    args = ap.parse_args()

    with open(args.bib, encoding="utf-8") as fh:
        entries = parse_bib(fh.read())
    failed = 0
    for key, fields in entries.items():
        status, detail = verify(key, fields)
        failed += status == "FAIL"
        print(f"{status:4}  {key}: {detail}")
        time.sleep(0.15)  # stay well inside Crossref/NCBI rate limits

    for path in args.text:
        with open(path, encoding="utf-8") as fh:
            used = set(re.findall(r"@([\w:.#$%&+?<>~/-]+[\w])", fh.read()))
        for key in sorted(used - entries.keys()):
            if re.search(r"\.\w+$", key) and "." in key:  # skip e-mail-like tokens
                continue
            failed += 1
            print(f"FAIL  {key}: cited in {path} but missing from {args.bib}")

    print(f"\n{len(entries)} entries checked, {failed} failure(s)")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
